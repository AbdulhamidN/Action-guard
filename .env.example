PORT=
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
REDIS_URL=
JWT_SECRET=
MAXMIND_DB_PATH=
IMPOSSIBLE_TRAVEL_SPEED_THRESHOLD_KMH=900
BOT_TIMING_WINDOW_SECONDS=60
BOT_TIMING_MAX_HISTORY=10
BOT_TIMING_MIN_REQUESTS=3
BOT_TIMING_BURST_MIN_INTERVAL_MS=150
BOT_TIMING_BURST_AVG_INTERVAL_MS=300
BOT_TIMING_REGULARITY_MAX_INTERVAL_MS=5000
BOT_TIMING_REGULARITY_CV_THRESHOLD=0.15
BASELINE_MIN_LOGINS=5
BASELINE_RECALCULATION_SCHEDULE=0 2 * * *
BASELINE_RECALCULATION_AUTO_START=true
# Platform administrator API key (>= 32 characters; must be distinct from API_KEY / ACTIONGUARD_API_KEY).
# Generate safely with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACTIONGUARD_ADMIN_API_KEY=

# AES-256-GCM key for encrypting webhook signing secrets at rest (required in development and production; >= 32 chars, 64-char hex recommended).
# Generate safely with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: Keep WEBHOOK_SECRET_ENCRYPTION_KEY stable across application restarts and all delivery-worker processes so persisted webhook secrets remain decryptable.
WEBHOOK_SECRET_ENCRYPTION_KEY=

SOCKET_SESSION_REVALIDATION_INTERVAL_SECONDS=30
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
